# Named targets for scripts/deploy.sh and scripts/run-tests.sh.
# Sourced by bash. Paths are relative to the repo root unless absolute.

# SSH key used for every target (see docs/TARGETS.md).
TARGET_KEY="${TARGET_KEY:-$HOME/.ssh/qnx_target_ed25519}"

# --- qemu: x86_64 QEMU image built by mkqnximage in targets/qemu-x86_64 ---
# The address comes from DHCP on br0 and can change between boots, so it is
# looked up with `mkqnximage --getip` unless TARGET_HOST is set.
qemu_ARCH=x86_64
qemu_USER=root
qemu_DIR=/data/home/root/arbiter/bin
qemu_IMAGE_DIR=targets/qemu-x86_64
# The image (and its host key) is rebuilt often on a private host-only bridge,
# so host keys are not pinned for this target.
qemu_SSH_HOSTKEY_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"

# --- pi5: Raspberry Pi 5 (aarch64le), from M3 ---
pi5_ARCH=aarch64le
pi5_USER=root
pi5_DIR=/data/home/root/arbiter/bin
pi5_HOST="${PI5_HOST:-}"
pi5_SSH_HOSTKEY_OPTS="-o StrictHostKeyChecking=accept-new"
