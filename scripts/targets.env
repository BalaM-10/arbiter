# Named targets for scripts/deploy.sh and scripts/run-tests.sh.
# Sourced by bash. Paths are relative to the repo root unless absolute.

# SSH key used for every target (see docs/TARGETS.md).
TARGET_KEY="${TARGET_KEY:-$HOME/.ssh/qnx_target_ed25519}"

# --- qemu: x86_64 QEMU image built by mkqnximage in targets/qemu-x86_64 ---
# The address comes from DHCP on br0 and can change between boots, so it is
# looked up with `mkqnximage --getip` unless TARGET_HOST is set.
qemu_ARCH=x86_64
qemu_USER=root
qemu_DIR=/data/home/root/arbiter/bin
qemu_IMAGE_DIR=targets/qemu-x86_64
# Timing rule for tests that measure it: QEMU proves function, never timing
# (owner decision 2026-11-13). FR-G9 test_send_timeout changed to this on QEMU
# after observed failures (run-151353.log, fr-g9-repeat-152521.log).
qemu_TIMING=function
# The image (and its host key) is rebuilt often on a private host-only bridge,
# so host keys are not pinned for this target.
qemu_SSH_HOSTKEY_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"
# Security policy on this image: off (FR-S6, the code-level checks alone).
qemu_POLICY=off
# The gateway's listening interface (passed as arb-gateway -i). Empty: the
# gateway's default, the first interface that is up, running, not loopback and
# has an IPv4 address; QEMU has one, vtnet0 (the private bridge br0).
qemu_GW_IFACE=

# --- qemu_secpol: the same QEMU target with the security policy (M2 P5, D5) ---
# Built by scripts/build-image.sh in targets/qemu-x86_64-secpol; one QEMU image
# runs at a time. Every Arbiter process starts with its own type (on -T).
qemu_secpol_ARCH=x86_64
qemu_secpol_USER=root
qemu_secpol_DIR=/data/home/root/arbiter/bin
qemu_secpol_IMAGE_DIR=targets/qemu-x86_64-secpol
qemu_secpol_TIMING=function
qemu_secpol_SSH_HOSTKEY_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"
qemu_secpol_POLICY=on
qemu_secpol_GW_IFACE=

# --- pi5: Raspberry Pi 5 (aarch64le), from M3 ---
pi5_ARCH=aarch64le
pi5_USER=root
pi5_DIR=/data/home/root/arbiter/bin
pi5_TIMING=strict
pi5_POLICY=off
# Required on the Pi 5: its wired Ethernet by name, so the gateway never listens on
# Wi-Fi, which "the first interface that is up" could be. The Pi 5 BSP's Ethernet
# driver is devs-cgem.so; neither its page nor the BSP's driver page states the
# interface name it creates, so it is read from `ifconfig` on the board (M3) and
# set here or in PI5_GW_IFACE (docs/TARGETS.md).
# QNX 8.0: https://www.qnx.com/developers/docs/BSP8.0/com.qnx.doc.bsp_raspberrypi.bcm2712.rpi5_8.0/topic/driver_commands.html
# QNX 8.0: https://www.qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/d/devs-cgem.so.html
pi5_GW_IFACE="${PI5_GW_IFACE:-}"
pi5_GW_IFACE_REQUIRED=yes
pi5_HOST="${PI5_HOST:-}"
pi5_SSH_HOSTKEY_OPTS="-o StrictHostKeyChecking=accept-new"
