#include <errno.h>
#include <pthread.h>
#include <sched.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/procmgr.h>
#include <unistd.h>
static void tryp(int p){int rc=pthread_setschedprio(pthread_self(),p);printf("  prio %3d -> %s\n",p,rc?strerror(rc):"ok");}
int main(int argc,char**argv){
  int v=atoi(argv[1]); int rc=-1;
  struct sched_param sp={0}; sp.sched_priority=40; pthread_setschedparam(pthread_self(),SCHED_FIFO,&sp);
  switch(v){
  case 1: rc=procmgr_ability(0, PROCMGR_ADN_NONROOT|PROCMGR_AOP_ALLOW|PROCMGR_AID_PRIORITY,
     PROCMGR_ADN_NONROOT|PROCMGR_AOP_SUBRANGE|PROCMGR_AOP_LOCK|PROCMGR_AID_PRIORITY,(uint64_t)1,(uint64_t)70,
     PROCMGR_ADN_NONROOT|PROCMGR_AOP_DENY|PROCMGR_AOP_LOCK|PROCMGR_AID_EOL); break;
  case 2: rc=procmgr_ability(0, PROCMGR_ADN_NONROOT|PROCMGR_AOP_ALLOW|PROCMGR_AID_PRIORITY,
     PROCMGR_ADN_NONROOT|PROCMGR_AOP_SUBRANGE|PROCMGR_AID_PRIORITY,(uint64_t)1,(uint64_t)70,
     PROCMGR_ADN_NONROOT|PROCMGR_AOP_DENY|PROCMGR_AOP_LOCK|PROCMGR_AID_EOL); break;
  case 3: rc=procmgr_ability(0, PROCMGR_ADN_NONROOT|PROCMGR_AOP_SUBRANGE|PROCMGR_AID_PRIORITY,(uint64_t)1,(uint64_t)70,
     PROCMGR_ADN_NONROOT|PROCMGR_AOP_ALLOW|PROCMGR_AID_PRIORITY,
     PROCMGR_ADN_NONROOT|PROCMGR_AOP_DENY|PROCMGR_AOP_LOCK|PROCMGR_AID_EOL); break;
  case 4: rc=procmgr_ability(0, PROCMGR_ADN_NONROOT|PROCMGR_AOP_ALLOW|PROCMGR_AOP_SUBRANGE|PROCMGR_AID_PRIORITY,(uint64_t)1,(uint64_t)70,
     PROCMGR_ADN_NONROOT|PROCMGR_AOP_DENY|PROCMGR_AOP_LOCK|PROCMGR_AID_EOL); break;
  case 5: rc=procmgr_ability(0, PROCMGR_ADN_NONROOT|PROCMGR_AOP_DENY|PROCMGR_AOP_LOCK|PROCMGR_AID_EOL); break;
  case 6: rc=procmgr_ability(0, PROCMGR_ADN_NONROOT|PROCMGR_AOP_ALLOW|PROCMGR_AID_PRIORITY,
     PROCMGR_ADN_NONROOT|PROCMGR_AOP_DENY|PROCMGR_AOP_LOCK|PROCMGR_AID_EOL); break;
  }
  printf("variant %d procmgr_ability rc %d (%s)\n",v,rc,rc?strerror(rc):"EOK");
  if(setreuid(811,811)) perror("setreuid");
  printf("  euid %d\n",(int)geteuid());
  tryp(40); tryp(63); tryp(64); tryp(70); tryp(71); tryp(100); tryp(200);
  return 0;}

