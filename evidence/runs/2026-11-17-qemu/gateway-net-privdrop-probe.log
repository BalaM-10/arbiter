## probe 2 source (listen as root, drop, then accept two connections from the host: printf 'ping\n' | nc <target> 7700, twice)
#include <errno.h>
#include <fcntl.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <arpa/inet.h>
#include <poll.h>
#include <stdio.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>
#include "arb_privdrop.h"
#define R(x) do { int _r = (x); printf("  %-44s %s\n", #x, _r == -1 ? strerror(errno) : "ok"); } while (0)
/* listen as root, drop, then accept connections from a peer started by the shell */
int main(void)
{
    const char *what; int err; char rep[ARB_PRIVDROP_REPORT_LEN];
    int one = 1;
    int l = socket(AF_INET, SOCK_STREAM, 0); printf("  socket(listen) as root %s\n", l == -1 ? strerror(errno) : "ok");
    R(setsockopt(l, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one));
    struct sockaddr_in a; memset(&a, 0, sizeof a); a.sin_family = AF_INET; a.sin_port = htons(7700); a.sin_addr.s_addr = htonl(INADDR_ANY);
    R(bind(l, (struct sockaddr *)&a, sizeof a));
    R(listen(l, 1));
    if (arb_privdrop(814, 10, 0, 0, 0, &what, &err, rep) != 0) { printf("privdrop failed: %s: %s\n", what, strerror(err)); return 1; }
    printf("%s\n", rep);
    fflush(stdout);
    for (int k = 0; k < 2; k++) {
        struct pollfd p = { l, POLLIN, 0 };
        printf("  poll(listen) -> %d\n", poll(&p, 1, 5000)); fflush(stdout);
        int s = accept(l, NULL, NULL); printf("  accept %d after drop: %s\n", k, s == -1 ? strerror(errno) : "ok");
        if (s == -1) continue;
        R(setsockopt(s, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one));
        R(fcntl(s, F_SETFL, O_NONBLOCK));
        char b[8]; struct pollfd q = { s, POLLIN, 0 }; (void)poll(&q, 1, 2000);
        ssize_t n = recv(s, b, sizeof b, 0); printf("  recv %zd\n", n);
        printf("  send %zd\n", send(s, "pong\n", 5, MSG_NOSIGNAL));
        close(s);
    }
    int x = socket(AF_INET, SOCK_STREAM, 0); printf("  new socket() after drop: %s\n", x == -1 ? strerror(errno) : "ok");
    return 0;
}

