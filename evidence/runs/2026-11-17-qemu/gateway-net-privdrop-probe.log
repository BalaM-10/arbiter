## probe 1 source (socket, bind, listen, connect, accept: once as root, once after the drop)
#include <errno.h>
#include <fcntl.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <arpa/inet.h>
#include <stdio.h>
#include <string.h>
#include <sys/socket.h>
#include <unistd.h>
#include "arb_privdrop.h"
#define R(x) do { int _r = (x); printf("  %-44s %s\n", #x, _r == -1 ? strerror(errno) : "ok"); } while (0)
int main(int argc, char **argv)
{
    const char *what; int err; char rep[ARB_PRIVDROP_REPORT_LEN];
    int drop = argc > 1 && strcmp(argv[1], "drop") == 0;
    if (drop) {
        if (arb_privdrop(814, 10, 0, 0, 0, &what, &err, rep) != 0) { printf("privdrop failed: %s: %s\n", what, strerror(err)); return 1; }
        printf("%s\n", rep);
    } else printf("no drop (root)\n");
    int l = socket(AF_INET, SOCK_STREAM, 0); printf("  socket(listen) %s\n", l == -1 ? strerror(errno) : "ok");
    int one = 1;
    R(setsockopt(l, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one));
    struct sockaddr_in a; memset(&a, 0, sizeof a); a.sin_family = AF_INET; a.sin_port = htons(7700); a.sin_addr.s_addr = htonl(INADDR_ANY);
    R(bind(l, (struct sockaddr *)&a, sizeof a));
    R(listen(l, 1));
    int c = socket(AF_INET, SOCK_STREAM, 0);
    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
    R(connect(c, (struct sockaddr *)&a, sizeof a));
    int s = accept(l, NULL, NULL); printf("  accept %s\n", s == -1 ? strerror(errno) : "ok");
    R(setsockopt(s, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one));
    R(setsockopt(s, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one));
    R(fcntl(s, F_SETFL, O_NONBLOCK));
    char b[8] = "abcdefg";
    printf("  send %zd recv %zd\n", send(c, b, 8, MSG_NOSIGNAL), recv(s, b, 8, 0));
    int fd = open("/dev/null", O_RDONLY); printf("  open /dev/null %s\n", fd == -1 ? strerror(errno) : "ok");
    struct sockaddr_in a2 = a; a2.sin_port = htons(80); int l2 = socket(AF_INET, SOCK_STREAM, 0);
    R(bind(l2, (struct sockaddr *)&a2, sizeof a2));
    return 0;
}

